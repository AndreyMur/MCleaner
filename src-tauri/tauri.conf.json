{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniCleaner",
  "version": "0.1.0",
  "identifier": "com.omnicleaner.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../src/frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "OmniCleaner",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Cross-platform package manager and cleaner",
    "longDescription": "OmniCleaner is a cross-platform desktop application for managing system packages and cleaning up cache and orphaned dependencies across Windows, macOS and Linux.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "AndreyMur",
    "homepage": "https://github.com/AndreyMur/MCleaner",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
